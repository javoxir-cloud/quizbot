[{"q":"Решите уравнение: 2x + 5 = 13. x = ?","options":["4","9","3","8"],"correct":"4"},{"q":"Формула дискриминанта квадратного уравнения?","options":["D = b^2 - 4ac","D = b^2 + 4ac","D = 2b - 4ac","D = a^2 - 4bc"],"correct":"D = b^2 - 4ac"},{"q":"Теорема Пифагора для прямоугольного треугольника?","options":["a^2 + b^2 = c^2","a + b = c","a^2 - b^2 = c^2","a*b = c^2"],"correct":"a^2 + b^2 = c^2"},{"q":"Формула площади круга?","options":["S = πr^2","S = 2πr","S = πd","S = 2r"],"correct":"S = πr^2"},{"q":"Чему равен log(1) при любом основании?","options":["0","1","10","не определён"],"correct":"0"},{"q":"Чему равна сумма sin^2(x) + cos^2(x)?","options":["1","0","2","sin(2x)"],"correct":"1"},{"q":"Формула n-го члена арифметической прогрессии?","options":["a_n = a_1 + (n-1)d","a_n = a_1 * d^n","a_n = a_1 / n","a_n = a_1 + nd^2"],"correct":"a_n = a_1 + (n-1)d"},{"q":"Формула n-го члена геометрической прогрессии?","options":["b_n = b_1 * q^(n-1)","b_n = b_1 + (n-1)q","b_n = b_1 / q","b_n = b_1 - nq"],"correct":"b_n = b_1 * q^(n-1)"},{"q":"Производная функции f(x) = x^2?","options":["2x","x^2","x","2"],"correct":"2x"},{"q":"Чему равно наименьшее общее кратное (НОК) чисел 3 и 5?","options":["15","1","8","3"],"correct":"15"},{"q":"Чему равна сумма внутренних углов четырёхугольника?","options":["360°","180°","270°","540°"],"correct":"360°"},{"q":"Чему равна сумма внутренних углов треугольника?","options":["180°","360°","90°","270°"],"correct":"180°"},{"q":"Каковы корни уравнения x^2 - 9 = 0?","options":["x = 3 или x = -3","x = 9","x = -9","только x = 3"],"correct":"x = 3 или x = -3"},{"q":"Формула объёма прямоугольного параллелепипеда?","options":["V = a*b*c","V = a+b+c","V = a^2*b","V = 2(a+b+c)"],"correct":"V = a*b*c"},{"q":"Что такое область определения функции?","options":["Множество значений, которые может принимать аргумент x","Наибольшее значение функции","График функции","Производная функции"],"correct":"Множество значений, которые может принимать аргумент x"},{"q":"Чему равно 2^5?","options":["32","10","25","16"],"correct":"32"},{"q":"Что из перечисленного относится к натуральным числам?","options":["1, 2, 3, ...","-1, -2, -3, ...","0.5, 1.5, 2.5","все действительные числа"],"correct":"1, 2, 3, ..."},{"q":"Чему равен модуль |−7|?","options":["7","-7","0","14"],"correct":"7"},{"q":"Чему равен кубический корень из 27 (∛27)?","options":["3","9","27","6"],"correct":"3"},{"q":"В уравнении прямой y = kx + b, что означает k?","options":["Угловой коэффициент (наклон)","Начальную точку","Длину","Угол в градусах"],"correct":"Угловой коэффициент (наклон)"},{"q":"В каком диапазоне находится значение вероятности?","options":["От 0 до 1","От 0 до 100","От -1 до 1","От 1 до 10"],"correct":"От 0 до 1"},{"q":"Как вычисляется число перестановок n элементов в комбинаторике?","options":["n! (n факториал)","n^2","2n","n/2"],"correct":"n! (n факториал)"},{"q":"Какие углы образуются при пересечении двух параллельных прямых секущей (соответственные углы)?","options":["Равные","Сумма 180°","Сумма 90°","Разные"],"correct":"Равные"},{"q":"Чему равно значение x в точке пересечения графика функции с осью Y?","options":["0","1","-1","не определено"],"correct":"0"}]
